<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>مصمم بطاقات دعوة حفل التخرج</title>
    <!-- استدعاء خطوط عربية أنيقة من جوجل -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Reem+Kufi:wght@500;700&display=swap" rel="stylesheet">
    <!-- مكتبة تحويل البطاقة إلى صورة -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f0f4f8;
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
            background: #fff;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        }
        h2 {
            color: #1e3a8a;
            text-align: center;
            border-bottom: 2px solid #e2e8f0;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }
        .form-section {
            background: #f8fafc;
            padding: 15px;
            border-radius: 8px;
            border: 1px solid #cbd5e1;
            margin-bottom: 25px;
        }
        .form-section h3 {
            margin-top: 0;
            color: #334155;
            font-size: 16px;
        }
        label {
            display: block;
            margin-top: 10px;
            font-weight: bold;
            color: #475569;
            font-size: 13px;
        }
        input, textarea {
            width: 100%;
            padding: 8px;
            margin-top: 5px;
            border: 1px solid #94a3b8;
            border-radius: 5px;
            box-sizing: border-box;
            background: #fff;
            font-family: 'Cairo', sans-serif;
            font-size: 15px;
        }
        
        /* تصميم بطاقة التخرج الفاخرة والأنيقة */
        .card-preview {
            background: linear-gradient(135deg, #1e3a8a 0%, #0f172a 100%);
            border: 5px solid #fbbf24; /* إطار ذهبي احتفالي */
            padding: 40px 25px;
            border-radius: 15px;
            text-align: center;
            color: #ffffff;
            box-shadow: 0 8px 25px rgba(30, 58, 138, 0.3);
            position: relative;
            overflow: hidden;
        }
        
        .card-preview::before {
            content: "";
            position: absolute;
            top: 12px;
            right: 12px;
            bottom: 12px;
            left: 12px;
            border: 1px dashed rgba(251, 191, 36, 0.5);
            border-radius: 10px;
            pointer-events: none;
        }

        .celebration-icon {
            font-size: 32px;
            margin-bottom: 10px;
        }

        .card-preview h3 {
            color: #fbbf24;
            font-family: 'Reem Kufi', sans-serif;
            font-size: 26px;
            margin: 5px 0 15px 0;
        }

        .graduate-name {
            font-size: 32px;
            font-weight: bold;
            color: #ffffff;
            background: rgba(255, 255, 255, 0.1);
            padding: 10px 20px;
            border-radius: 8px;
            display: inline-block;
            margin: 15px 0;
            border-bottom: 3px solid #fbbf24;
        }

        .card-preview p {
            color: #e2e8f0;
            font-size: 17px;
            line-height: 1.8;
            margin: 10px 0;
        }

        .details-box {
            background: rgba(255, 255, 255, 0.15);
            padding: 15px 20px;
            border-radius: 8px;
            display: inline-block;
            margin-top: 15px;
            border: 1px solid rgba(251, 191, 36, 0.3);
            text-align: right;
            width: 85%;
        }
        .details-box p {
            margin: 8px 0;
            font-size: 16px;
            color: #ffffff;
        }
        
        .gold-text {
            color: #fbbf24;
            font-weight: bold;
        }

        .btn {
            background-color: #1e3a8a;
            color: white;
            padding: 12px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            width: 100%;
            font-size: 18px;
            font-weight: bold;
            font-family: 'Cairo', sans-serif;
            margin-top: 15px;
            transition: 0.3s;
        }
        .btn:hover { background-color: #1e40af; }
        .btn-copy { background-color: #d97706; }
        .btn-copy:hover { background-color: #b45309; }
    </style>
</head>
<body>

<div class="container">
    <h2>مصمم بطاقات دعوة حفل التخرج</h2>

    <!-- حقول الإدخال -->
    <div class="form-section">
        <h3>أدخل تفاصيل حفل التخرج:</h3>
        
        <label>عنوان الدعوة / الترحيب:</label>
        <input type="text" id="inSubIntro" value="يسعدني ويشرفني حضوركم حفل تخرجي" oninput="updateCard()">

        <label>اسم الخريج / الخريجة مع اللقب والتخصص:</label>
        <input type="text" id="inName" value="أحمد سامر الأحمد (هندسة البرمجيات)" oninput="updateCard()">

        <label>تاريخ الحفل:</label>
        <input type="text" id="inDate" value="الخميس، 20 / تموز / 2026" oninput="updateCard()">

        <label>وقت الحفل:</label>
        <input type="text" id="inTime" value="الساعة السابعة مساءً" oninput="updateCard()">

        <label>مكان الحفل (الجامعة أو القاعة):</label>
        <input type="text" id="inLocation" value="مدرج الحفلات الكبرى - جامعة المدينة" oninput="updateCard()">
    </div>

    <!-- البطاقة البصرية (المعاينة الحية) -->
    <div class="card-preview" id="gradCard">
        <div class="celebration-icon">🎓 ✨ 🎓</div>
        
        <h3 id="outSubIntro">يسعدني ويشرفني حضوركم حفل تخرجي</h3>
        
        <div class="graduate-name" id="outName">أحمد سامر الأحمد (هندسة البرمجيات)</div>

        <div class="details-box">
            <p>📅 <strong class="gold-text">التاريخ:</strong> <span id="outDate">الخميس، 20 / تموز / 2026</span></p>
            <p>⏰ <strong class="gold-text">الوقت:</strong> <span id="outTime">الساعة السابعة مساءً</span></p>
            <p>📍 <strong class="gold-text">المكان:</strong> <span id="outLocation">مدرج الحفلات الكبرى - جامعة المدينة</span></p>
        </div>

        <p style="margin-top: 20px; font-weight: bold; color: #fbbf24;">وجودكم يضفي على فرحتي سعادة أكبر!</p>
    </div>

    <!-- أزرار التحميل والنسخ -->
    <button class="btn" onclick="downloadCardImage()">📥 تحميل بطاقة التخرج كصورة</button>
    <button class="btn btn-copy" onclick="copyPostText()">📋 نسخ نص الدعوة جاهزاً للنشر</button>
</div>

<script>
    function updateCard() {
        document.getElementById('outSubIntro').innerText = document.getElementById('inSubIntro').value;
        document.getElementById('outName').innerText = document.getElementById('inName').value;
        document.getElementById('outDate').innerText = document.getElementById('inDate').value;
        document.getElementById('outTime').innerText = document.getElementById('inTime').value;
        document.getElementById('outLocation').innerText = document.getElementById('inLocation').value;
    }

    function downloadCardImage() {
        const cardElement = document.getElementById('gradCard');
        html2canvas(cardElement, { scale: 2 }).then(canvas => {
            let link = document.createElement('a');
            link.download = 'graduation-invitation.png';
            link.href = canvas.toDataURL('image/png');
            link.click();
        });
    }

    function copyPostText() {
        const sub = document.getElementById('inSubIntro').value;
        const name = document.getElementById('inName').value;
        const date = document.getElementById('inDate').value;
        const time = document.getElementById('inTime').value;
        const location = document.getElementById('inLocation').value;

        const postText = `🎓 *دعوة حفل تخرج*\n\n` +
                         `${sub}:\n` +
                         `✨ *${name}* ✨\n\n` +
                         `📅 التاريخ: ${date}\n` +
                         `⏰ الوقت: ${time}\n` +
                         `📍 المكان: ${location}\n\n` +
                         `يسعدني جداً حضوركم ومشاركتي هذه اللحظة المميزة!\n\n` +
                         `#تخرج #حفل_تخرج #دفعة_2026 #نجاح`;

        navigator.clipboard.writeText(postText).then(() => {
            alert('تم نسخ نص الدعوة بنجاح! يمكنك لصقه الآن في المنشور مع الصورة المرفقة.');
        });
    }
</script>

</body>
</html>
